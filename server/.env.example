# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Legacy user-login JWT (users.js / items.js — untouched CRUD demo) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Database ---
MONGODB_URL=mongodb://localhost:27017/ai-personalization

# --- Session JWT (AI Personalization deep links — tokenService.js) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email (Nodemailer — use Ethereal for local dev: https://ethereal.email) ---
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=AI Personalization <noreply@ai-personalization.com>

# --- URLs ---
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000

# --- Storage ---
UPLOAD_DIR=uploads/originals
MAX_FILE_SIZE=10485760

# --- AI providers ---
HUGGINGFACE_API_KEY=
# Black Forest Labs API key — only needed for the wrapper-composite
# multi-reference generation mode (blackForestLabsService.js).
BFL_API_KEY=

# Dev-only: set to "true" to skip real HF/BFL calls across all 4 generation
# modes and return a cheap stand-in result instead (see aiService.js). Leave
# unset/false to actually call the AI providers.
BYPASS_AI=false

# --- Redis (Upstash — used by BullMQ queues, see queues/aiQueue.js) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
